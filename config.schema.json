{
  "pluginAlias": "iAquaLink",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "<p align=\"center\"><img src=\"https://raw.githubusercontent.com/dean1d/homebridge-iAqualink-Matter/main/assets/Jandy.png\" alt=\"Jandy iAquaLink logo\" width=\"180\"></p>\n\nControl supported Jandy iAquaLink pool equipment through HomeKit and Matter.\n\n> This independent community plugin is not affiliated with or endorsed by Jandy or Fluidra.",
  "schema": {
    "type": "object",
    "required": ["name", "username", "password"],
    "properties": {
      "name": {"title": "Name", "type": "string", "default": "iAquaLink"},
      "username": {"title": "iAquaLink Email", "type": "string"},
      "password": {"title": "iAquaLink Password", "type": "string"},
      "enableCloudControl": {
        "title": "Enable Cloud Control",
        "description": "Allow HomeKit and Matter to send commands to real pool equipment.",
        "type": "boolean",
        "default": true
      },
      "pollIntervalSeconds": {"title": "Polling Interval", "type": "integer", "minimum": 15, "maximum": 300, "default": 30},
      "diagnosticMode": {"title": "Diagnostic Logging", "type": "boolean", "default": false},
      "exposeLightShows": {
        "title": "Expose Light Colors and Shows as Switches",
        "description": "Add a momentary HomeKit switch for each discovered Jandy light color and show.",
        "type": "boolean",
        "default": true
      },
      "poolLightProgram": {
        "title": "Pool Light Program",
        "type": "string",
        "default": "Caribbean Blue",
        "enum": ["Alpine White", "Sky Blue", "Cobalt Blue", "Caribbean Blue", "Spring Green", "Emerald Green", "Emerald Rose", "Magenta", "Violet", "Slow Color Splash", "Fast Color Splash", "America The Beautiful", "Fat Tuesday", "Disco Tech"]
      },
      "spaLightProgram": {
        "title": "Spa Light Program",
        "type": "string",
        "default": "Caribbean Blue",
        "enum": ["Alpine White", "Sky Blue", "Cobalt Blue", "Caribbean Blue", "Spring Green", "Emerald Green", "Emerald Rose", "Magenta", "Violet", "Slow Color Splash", "Fast Color Splash", "America The Beautiful", "Fat Tuesday", "Disco Tech"]
      },
      "excludedDevices": {
        "title": "Hide These Devices",
        "description": "Checked devices are not published to HomeKit or Matter, and are removed if they were published before.",
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "oneOf": [
            {"title": "Air Temperature", "enum": ["air-temperature"]},
            {"title": "Pool Temperature", "enum": ["pool-temperature"]},
            {"title": "Spa Temperature", "enum": ["spa-temperature"]},
            {"title": "Pool Heater", "enum": ["pool-heater"]},
            {"title": "Spa Heater", "enum": ["spa-heater"]},
            {"title": "Heat Pump / Chiller", "enum": ["heat-pump"]},
            {"title": "Filter Pump", "enum": ["filter-pump"]},
            {"title": "Spa Mode", "enum": ["spa-mode"]},
            {"title": "Air Blower", "enum": ["air-blower"]},
            {"title": "Sheer Descent", "enum": ["sheer-descent"]},
            {"title": "High Speed", "enum": ["high-speed"]},
            {"title": "Pool Light", "enum": ["pool-light"]},
            {"title": "Spa Light", "enum": ["spa-light"]},
            {"title": "Salt Water Chlorinator", "enum": ["swg"]}
          ]
        }
      },
      "excludedDeviceNames": {
        "title": "Other Devices to Hide",
        "description": "Names or IDs of other devices to hide, such as an auxiliary circuit's iAquaLink label (for example, Jet Pump). The Homebridge log lists every discovered device's name and ID at startup.",
        "type": "array",
        "items": {"type": "string", "title": "Device name or ID"}
      },
      "useMockApi": {"title": "Use Mock API (Development Only)", "type": "boolean", "default": false}
    }
  },
  "layout": [
    "name", "username", "password", "enableCloudControl", "pollIntervalSeconds",
    "exposeLightShows",
    "poolLightProgram", "spaLightProgram",
    {
      "type": "fieldset",
      "title": "Hide Devices",
      "description": "Keep equipment you don't have or don't use out of HomeKit and Matter.",
      "expandable": true,
      "items": [
        {
          "key": "excludedDevices",
          "type": "checkboxes"
        },
        {
          "key": "excludedDeviceNames",
          "type": "array",
          "buttonText": "Add device",
          "items": [{"key": "excludedDeviceNames[]", "placeholder": "Device name or ID"}]
        }
      ]
    },
    "diagnosticMode", "useMockApi"
  ]
}
